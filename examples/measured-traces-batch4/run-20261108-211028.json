      "content": "\"\"\"Input validation helpers.\"\"\"\n\n\ndef parse_age(value):\n    \"\"\"Parse an age string into an int.\"\"\"\n    try:\n        age = int(value)\n    except ValueError:\n        raise ValueError(\"Invalid age input. Please enter a numeric value.\")\n\n    if age < 0:\n        raise ValueError(\"Age cannot be negative.\")\n    elif age > 150:\n        raise ValueError(\"Age cannot be over 150.\")\n\n    return age\n"
